<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1724714365823-1" author="Kacper Król">
        <createTable tableName="employees">
            <column name="id" type="char(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="employees_pkey"/>
            </column>
            <column name="hire_date" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="surname" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="manager_id" type="char(36)"/>
        </createTable>
    </changeSet>

    <changeSet id="1724714365823-1-uuid" author="Kacper Król">
        <sql>
            ALTER TABLE employees
                ALTER COLUMN id SET DATA TYPE uuid USING id::uuid;
            ALTER TABLE employees
                ALTER COLUMN manager_id SET DATA TYPE uuid USING manager_id::uuid;
        </sql>
    </changeSet>

</databaseChangeLog>
